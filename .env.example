# Copie para .env (que não vai para o git) e preencha a chave do provedor que for usar.
# Com uma chave, cada PDF recebe a segunda leitura por LLM; sem nenhuma, vale a leitura geométrica/OCR.
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Opcional: modelo e nível de raciocínio da leitura por LLM (o provedor sai do nome do modelo)
# LEITOR_MODELO=gpt-6-luna
# LEITOR_ESFORCO=low

# Captura por e-mail: a senha da caixa IMAP (o nome da variável vem de senha_env, em fontes/*.json).
# COLETA_EMAIL_SENHA=
# Troca o servidor da caixa sem mudar o arquivo da fonte (no Docker, o servidor de demonstração se chama "email").
# COLETA_EMAIL_SERVIDOR=
