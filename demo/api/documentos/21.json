.4,626.2],"revisar":false,"corrigida":false},{"id":3691,"faixa":"54-58","geometrico":1736.5,"llm":1736.5,"calculado":1736.5,"valor":1736.5,"status":"confirmado","caixa":[422.9,632.5,454.5,640.5],"revisar":false,"corrigida":false},{"id":3692,"faixa":"59+","geometrico":2413.39,"llm":2413.39,"calculado":2413.39,"valor":2413.39,"status":"confirmado","caixa":[422.6,646.8,454.8,654.8],"revisar":false,"corrigida":false}]}],"url_origem":"https://safeadmin.com.br/wp-content/uploads/Tabela-Unimed-Jundiai-1.0r.pdf","achados_documento":[],"extra_llm":{"avisos":["p. 1: Página de capa: não há tabelas de preço nem informações sobre contratação, vigência, produtos, coparticipação, carências ou elegibilidade.","p. 1: Também aparece o logotipo Safe, sem indicação impressa nesta página de sua função como administradora.","p. 2: Página de menu; não há tabelas de preço nem informações sobre produtos, coparticipação, carências ou elegibilidade. Itens impressos: Diferenciais Safe, Tabela de Preço, Coparticipação, Vigência, Área de Comercialização, Quem pode aderir, Entidade de Classe e Rede credenciada.","p. 3: A página não contém tabelas de preço nem informações sobre produtos, operadora, vigência ou elegibilidade.","p. 5: O material informa reajuste em julho de 2027; não há data de vigência impressa.","p. 6: A soma das coparticipações, por beneficiário, não poderá ultrapassar R$ 250,00.","p. 6: A relação detalhada de Exames Simples, Exames Complexos e Procedimento Simples poderá ser consultada. O texto impresso termina nessa frase.","p. 6: Os valores de coparticipação para internação serão cobrados por evento, independentemente da quantidade de dias que o beneficiário fique internado.","p. 7: A página não contém tabelas de preço.","p. 7: Regra de redução de carência: Sem Plano Anterior: caso do beneficiário não possuir plano anterior. Com mais de 12 meses no plano anterior: no caso do beneficiário com plano anterior com mais de 12 meses.","p. 7: Documento obrigatório: Carta de Permanência com até 30 dias de emissão devidamente assinada e datada junto a operadora anterior. Quadro poderá sofrer alterações sem aviso prévio.","p. 7: Prazo para aproveitamento de carências oriundos de planos anteriores (congêneres) é contado 30 dias a partir da assinatura do contrato.","p. 7: A compra de carência será aceita para as seguintes congêneres: Hapvida Notredame, Sobam, Unimed, Amil, Bradesco, Sul America, Porto Seguros, Allianz, Sompo, Plena Saúde, São Cristóvão, Transmontano.","p. 7: Tabela NOSSAS DATAS: protocolo 05 dias antecedentes a vigência — vigência/vencimento Dia 01; protocolo 05 dias antecedentes a vigência — Dia 10; protocolo 05 dias antecedentes a vigência — Dia 20. Não são datas de vigência inicial ou final.","p. 8: A página não contém tabelas de preço.","p. 8: Na tabela de cidades de comercialização, o campo 'Estado' está preenchido com 'Jundiaí'; não há UF impressa.","p. 9: A página apresenta uma tabela de elegibilidade para titulares e taxas mensais associativas, mas não contém tabelas de preço de planos de saúde.","p. 10: A página 10 contém uma tabela de rede credenciada de hospitais, não tabelas de preço. A tabela lista hospitais e siglas de atendimento para Jundiaí, Cabreúva/SP, Franco da Rocha/SP, Salto/ITU, Itupeva/SP, Jarinu/SP e Louveira/SP; esses dados não têm campos correspondentes no esquema.","p. 11: A página contém uma lista de clínicas e tipos de atendimento para Jundiaí; não há tabelas de preço nem outros campos do esquema impressos.","p. 12: A página contém uma tabela de clínicas e tipos de atendimento, não tabelas de preço. Não há preços, produtos, condições de venda, coparticipação, carências ou elegibilidade impressos.","p. 13: A página 13 contém tabelas de clínicas e laboratórios credenciados, não tabelas de preços.","p. 13: A operadora foi identificada como Unimed SP pela menção impressa ao APP Unimed SP Clientes.","p. 14: Página de capa: não há tabelas de preço nem outras informações de plano impressas. Também aparece o lo